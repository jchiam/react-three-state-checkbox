{
  "name": "react-three-state-checkbox",
  "version": "4.0.1",
  "description": "React component for checkbox that supports the indeterminate state conveniently.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf ./lib && tsc",
    "prepare": "is-ci || husky",
    "test": "rm -rf .nyc_output && playwright test --config=playwright-ct.config.mjs",
    "test:ui": "rm -rf .nyc_output && playwright test --config=playwright-ct.config.mjs --ui",
    "lint": "eslint ./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchiam/react-three-state-checkbox.git"
  },
  "keywords": [
    "react",
    "typescript",
    "checkbox",
    "indeterminate"
  ],
  "author": "Jonathan Chiam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jchiam/react-three-state-checkbox/issues"
  },
  "homepage": "https://github.com/jchiam/react-three-state-checkbox#readme",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "lib",
    "LICENSE"
  ],
  "devDependencies": {
    "@jchiam/eslint-config": "^7.0.0",
    "@playwright/experimental-ct-react": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.8",
    "vite-plugin-istanbul": "^9.0.0"
  },
  "peerDependencies": {
    "react": "18 || 19",
    "react-dom": "18 || 19"
  },
  "overrides": {
    "vite": "^8.0.8",
    "@vitejs/plugin-react": "^5.0.0",
    "js-yaml": "^4.2.0"
  }
